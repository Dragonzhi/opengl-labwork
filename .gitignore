# ============================================================================
# OpenGL-Lab —— Git 忽略规则
#
# 原则：仓库只保存「源码 + 配置」；本地工具链、构建产物、IDE 本地文件不入库。
# 目录结构：
#   ./.cmd            构建/运行脚本（入库）
#   ./project/src     本项目源码（入库）
#   ./project/third_party/freeglut  随包分发的第三方源码（入库）
#   ./project/.vscode 团队共享的 VS Code 配置（入库，仅排除本地私有项）
#   ./project/build   CMake 生成目录（忽略）
#   ./tools           MinGW + CMake 工具链，约 1GB（忽略，随压缩包单独分发）
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 本地工具链（MinGW-w64 + CMake）
#    内容超过 1GB / 2万个文件，不适合进 Git；解包整个 OpenGL-Lab 压缩包即可获得。
#    如确实需要入库，可删除本段，或使用 git add -f tools/
# ---------------------------------------------------------------------------
/tools/

# ---------------------------------------------------------------------------
# 2. CMake 构建目录与生成文件
# ---------------------------------------------------------------------------
/project/build/
# 兜底：任意位置生成的 CMake 产物
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
/deps/
/project/deps/

# ---------------------------------------------------------------------------
# 3. 编译 / 链接产物（MinGW-GCC 与 MSVC）
# ---------------------------------------------------------------------------
*.exe
*.exe.manifest
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.idb
*.exp
*.map
*.gch
*.gcda
*.gcno
*.d
*.depend
*.tlog
*.manifest

# ---------------------------------------------------------------------------
# 4. IDE / 编辑器
#    .vscode 下只保留团队共享配置，个人配置一律忽略
# ---------------------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.code-workspace

.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/tasks.json
# 如需共享 settings.json，取消下一行注释
# !.vscode/settings.json

# ---------------------------------------------------------------------------
# 5. 操作系统垃圾文件
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# 6. 临时文件与补丁残留
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*.log
*~
*.swp
